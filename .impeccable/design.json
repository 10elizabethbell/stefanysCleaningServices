      "css": ".ds-rows{list-style:none;margin:0;padding:8px 24px;background:#0a5196}.ds-rows li+li{border-top:1px solid rgba(255,255,255,.14)}.ds-row{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:76px;padding:12px 0;text-decoration:none;color:#f4f7fb;font:400 clamp(22px,6vw,28px)/1.15 \"Cal Sans\",\"Avenir Next\",system-ui,sans-serif}.ds-row:focus-visible{outline:none}.ds-arrow{width:44px;height:44px;flex:none;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.12);color:#f4f7fb;transition:background-color .2s,color .2s}.ds-row:hover .ds-arrow{background:#8cc63f;color:#0b2a4a}.ds-row:focus-visible .ds-arrow{background:#8cc63f;color:#0b2a4a;outline:3px solid #8cc63f;outline-offset:3px}"
