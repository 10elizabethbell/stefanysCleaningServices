      "css": ".ds-card{background:#fff;border-radius:24px;padding:24px;display:grid;gap:8px;max-width:420px;box-shadow:0 10px 30px rgba(11,42,74,.06)}.ds-label{font:400 18px/1.2 \"Cal Sans\",\"Avenir Next\",system-ui,sans-serif;color:#0b2a4a}.ds-input{width:100%;font:16px/1.4 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Arial,sans-serif;color:#0b2a4a;background:#e6ecf5;border:2px solid transparent;border-radius:10px;padding:13px 14px;min-height:52px;caret-color:#0a5196;transition:border-color .15s}.ds-input::placeholder{color:#55657a}.ds-input:hover,.ds-input:focus{outline:none;border-color:#077dd4}"
